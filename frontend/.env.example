# Copie para .env.local e ajuste.
# URL da API (sem barra no final). Local: http://127.0.0.1:3000
# A origem do front (http://127.0.0.1:5173) precisa estar em CORS_ORIGINS no backend.
VITE_API_URL=https://lar-ternura-api.onrender.com

# true = usa dados simulados no navegador (cenário do 05_DADOS_FICTICIOS.sql), sem chamar a API.
# Use enquanto as rotas reais não estiverem prontas.
VITE_USAR_MOCK=true
