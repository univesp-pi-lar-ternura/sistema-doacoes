{
  "name": "lar-ternura-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "check:cloudflare": "npm run build:cloudflare && wrangler deploy --dry-run"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.11",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.1.11",
    "vite": "5.4.21",
    "vitest": "2.1.9",
    "wrangler": "4.155.0"
  }
}
