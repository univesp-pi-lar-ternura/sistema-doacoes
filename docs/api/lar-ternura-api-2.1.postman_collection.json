        {
          "name": "POST /agendamentos — Registrar promessa vinculada à meta selecionada",
          "request": {
            "method": "POST",
            "description": "Permite agendar necessidades abertas de produtos ativos mesmo com meta atingida. Exige id_necessidade atual; metas encerradas/canceladas/renovadas e produtos inativos continuam sendo recusados. A promessa não altera a arrecadação confirmada.",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{chave_post_agendamentos}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/agendamentos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "agendamentos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doador\": {\n    \"nome\": \"Pessoa fictícia\",\n    \"email\": \"doador@example.test\",\n    \"telefone\": \"11999999999\",\n    \"tipo_doador\": \"PF\"\n  },\n  \"data\": \"{{data_agendamento}}\",\n  \"horario\": \"{{horario}}\",\n  \"itens\": [\n    {\n      \"id_item\": 1,\n      \"id_necessidade\": \"{{id_necessidade}}\",\n      \"quantidade_doada\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('chave_post_agendamentos')) pm.collectionVariables.set('chave_post_agendamentos', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if ([200,201].includes(pm.response.code)) { const b=pm.response.json(); pm.collectionVariables.set('id', String(b.agendamento.id_agendamento)); pm.collectionVariables.set('token_agendamento', b.token_acesso); }"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /calendario/feriados/{ano} — Consultar calendário informativo da BrasilAPI",
          "request": {
            "method": "GET",
            "description": "Consulta opcional. Não bloqueia agendamentos nem altera vagas. HTTP 200 também pode conter status indisponivel; nesse caso feriados é null. Datas e tipos são informações do provedor, não regra de funcionamento da ONG.",
