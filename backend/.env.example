PORT=3000
DATABASE_URL=postgresql://usuario:senha@localhost:5432/neondb
# Use uma chave aleatória com pelo menos 32 caracteres. Nunca commitar .env.
BOOKING_TOKEN_SECRET=
CORS_ORIGINS=http://localhost:5173
DELIVERY_TIMES=09:00,10:00,14:00,15:00
SLOT_CAPACITY=3
SESSION_HOURS=8
# Ajustar somente conforme a quantidade de proxies confiáveis da hospedagem.
TRUST_PROXY_HOPS=0
